    "rule_type": "JSONata",
    "conditions": "study.documentedBy[templateName = \"M11\"].{\n    \"isNumeric\": $type(versions.version) = \"string\"  and versions.version ~> /^[0-9\\.]{1,}$/m,\n    \"id\":id,\n    \"type\":type,\n    \"versions\":versions\n}[$not(isNumeric)].{\n    \"id\":id,\n    \"code\": type.code,\n    \"codeSystem\": type.codeSystem,\n    \"versionId\": versions.id,\n    \"isNumeric\": isNumeric,\n    \"versionCode\": versions.status.id,\n    \"version\": versions.version\n}\n",
    "actions": [
      {
        "name": "generate_dataset_error_objects",
        "params": {
          "message": "The specified version number for of the M11 document has not an numeric format.\n"
