    "conditions": "$distinct(\n    study.versions.titles[\n        $not(\n            $uppercase(type.code) = \"C94108\"\n                and $uppercase(type.decode) = \"STUDY ACRONYM\"\n                )\n        and instanceType = \"StudyTitle\"].{\n        \"instanceType\": instanceType,\n        \"type\": type.instanceType\n    }\n)",
    "actions": [
      {
        "name": "generate_dataset_error_objects",
        "params": {
          "message": "The study version does not have a title of type \"Study Acronym\" (type.code = C94108 or type.decode = \"Study Acronym\", both case insensitive)."
